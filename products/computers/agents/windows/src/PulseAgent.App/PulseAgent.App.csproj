<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>PulseAgent.App</RootNamespace>
    <AssemblyName>$(PulseGuiName)</AssemblyName>
    <Description>$(PulseGuiName)</Description>
    <ApplicationIcon>Assets\$(PulseIconName).ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- The MSBuild PRI step needs the Visual Studio UWP workload; build.ps1 makes resources.pri
         with makepri.exe from the Windows SDK instead. -->
    <EnableCoreMrtTooling>false</EnableCoreMrtTooling>
    <!-- MVVMTK0045: field-based [ObservableProperty] AOT warning; partial properties do not yet
         work with the WinUI XAML compiler and CsWinRT together. -->
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250401001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PulseAgent.Core\PulseAgent.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\$(PulseIconName).png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\$(PulseIconName).ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
