<Window
    x:Class="PulseAgent.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: no title text, just the Prefs / Run / Logs selector centred in it. The rest of
             the bar is the drag target; the selector is a passthrough region so it takes clicks. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="Transparent">
            <SelectorBar x:Name="Tabs" HorizontalAlignment="Center" VerticalAlignment="Center"
                         SelectionChanged="Tabs_SelectionChanged" SizeChanged="Tabs_SizeChanged">
                <SelectorBarItem Text="Prefs" Tag="prefs" AutomationProperties.AutomationId="PrefsTab">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Run" Tag="run" AutomationProperties.AutomationId="RunTab">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Text="Logs" Tag="logs" AutomationProperties.AutomationId="LogsTab">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />

    </Grid>
</Window>
