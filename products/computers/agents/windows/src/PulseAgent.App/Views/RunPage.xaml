<Page
    x:Class="PulseAgent.App.Views.RunPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Control bar -->
        <Grid Grid.Row="0" Padding="24,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource AccentButtonStyle}" Click="SendNow_Click"
                    IsEnabled="{x:Bind ViewModel.CanSend, Mode=OneWay}"
                    ToolTipService.ToolTip="Ask the agent to send a heartbeat now">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE724;" FontSize="16" />
                    <TextBlock Text="Send now" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressRing IsActive="{x:Bind ViewModel.IsWaiting, Mode=OneWay}" Width="18" Height="18" />
                <TextBlock Text="{x:Bind ViewModel.UpdatedText, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <InfoBar Grid.Row="1" Margin="24,0,24,8" IsClosable="True"
                 IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                 Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                 Message="{x:Bind ViewModel.Message, Mode=OneWay}" />

        <MenuFlyoutSeparator Grid.Row="2" />

        <ScrollViewer Grid.Row="3" Padding="28,20">
            <StackPanel Spacing="16" MaxWidth="960" HorizontalAlignment="Center">

                <!-- What the status page shows for this computer -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="The status page shows this computer as" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SeatText, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.SeatReason, Mode=OneWay}" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE77B;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Session" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="Signed in" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SignedInText, Mode=OneWay}" />
                            <TextBlock Text="Locked" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.LockedText, Mode=OneWay}" />
                            <TextBlock Text="Idle" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.IdleText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                                <FontIcon Glyph="&#xE724;" FontSize="20" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock Text="Last send" Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <TextBlock Text="Event" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.LastSentText, Mode=OneWay}" />
                            <TextBlock Text="Result" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.LastResultText, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="Device certificate" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{x:Bind ViewModel.CertificateText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
