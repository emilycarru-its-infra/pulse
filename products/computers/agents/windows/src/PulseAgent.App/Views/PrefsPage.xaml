<Page
    x:Class="PulseAgent.App.Views.PrefsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:PulseAgent.Core"
    NavigationCacheMode="Required">

    <ScrollViewer Padding="28,24,28,24">
        <StackPanel Spacing="20" MaxWidth="960" HorizontalAlignment="Center">

            <!-- Header: icon, name, description, links and version, then a divider -->
            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,8,0,0">
                <Image x:Name="AppIcon" Width="96" Height="96" HorizontalAlignment="Center" />
                <TextBlock x:Name="AppName" Style="{StaticResource TitleTextBlockStyle}" HorizontalAlignment="Center" />
                <TextBlock Text="Tells the campus status page whether this computer is free, in use or off. It never sends who is signed in."
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" MaxWidth="560" TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
                    <HyperlinkButton Content="Documentation"
                                     NavigateUri="https://github.com/emilycarru-its-infra/pulse/tree/main/products/computers/agents/windows" />
                    <HyperlinkButton Content="Report Issue" NavigateUri="https://github.com/emilycarru-its-infra/pulse/issues" />
                </StackPanel>
                <TextBlock x:Name="VersionText" IsTextSelectionEnabled="True"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsSaveStatusVisible, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="{x:Bind ViewModel.SaveStatusGlyph, Mode=OneWay}" FontSize="12"
                          Foreground="{x:Bind ViewModel.SaveStatusBrush, Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.SaveStatusMessage, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{x:Bind ViewModel.SaveStatusBrush, Mode=OneWay}" />
            </StackPanel>

            <!-- One line for every policy-set value, instead of a caption on each -->
            <StackPanel Orientation="Horizontal" Spacing="6"
                        Visibility="{x:Bind ViewModel.HasPolicySettings, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Settings shown in gray have been configured by a policy."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Two columns; the cards stack within each -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE774;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Connection" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Ingest address" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBox Text="{x:Bind ViewModel.IngestUrl, Mode=TwoWay}"
                                 PlaceholderText="https://status.example.edu/computers/api/ingest"
                                 IsEnabled="{x:Bind ViewModel.CanEditIngestUrl, Mode=OneWay}" />
                        <TextBlock Text="Shared key" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                        <PasswordBox Password="{x:Bind ViewModel.IngestKey, Mode=TwoWay}" PasswordRevealMode="Peek"
                                     PlaceholderText="{x:Bind ViewModel.KeyPlaceholder, Mode=OneWay}"
                                     IsEnabled="{x:Bind ViewModel.CanEditIngestKey, Mode=OneWay}" />
                        <TextBlock Text="Only for a pilot: the device certificate is how the server knows this computer. The key is stored where only administrators can read it."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE7F4;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Device" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch OnContent="Present the device certificate" OffContent="Present the device certificate"
                                      IsOn="{x:Bind ViewModel.UseDeviceCertificate, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanEditUseDeviceCertificate, Mode=OneWay}" />
                        <TextBlock Text="Certificate" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.CertificateText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Text="Computer" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{x:Bind ViewModel.DeviceText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="16">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE916;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Timing" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Check the session every" Style="{StaticResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox Value="{x:Bind ViewModel.CheckIntervalValue, Mode=TwoWay}" Minimum="5" Maximum="300"
                                       SpinButtonPlacementMode="Compact" SmallChange="5" Width="120"
                                       IsEnabled="{x:Bind ViewModel.CanEditCheckInterval, Mode=OneWay}" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="Send a heartbeat every" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <NumberBox Value="{x:Bind ViewModel.HeartbeatIntervalValue, Mode=TwoWay}" Minimum="15" Maximum="3600"
                                       SpinButtonPlacementMode="Compact" SmallChange="15" Width="120"
                                       IsEnabled="{x:Bind ViewModel.CanEditHeartbeatInterval, Mode=OneWay}" />
                            <TextBlock Text="seconds" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="A sign-in, sign-out, lock or unlock is sent at once, whatever these say."
                                   Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                            <FontIcon Glyph="&#xE9D5;" FontSize="20"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Logging" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleSwitch OnContent="Enable verbose logging" OffContent="Enable verbose logging"
                                      IsOn="{x:Bind ViewModel.VerboseLogging, Mode=TwoWay}"
                                      IsEnabled="{x:Bind ViewModel.CanEditVerboseLogging, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- What the agent installs: one row per scheduled task, read-only. A click or Space
                 anywhere on a row's header expands it; hidden when the agent ships no task. -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20"
                    Visibility="{x:Bind ViewModel.HasServices, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,4">
                        <FontIcon Glyph="&#xE823;" FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Services" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="The scheduled tasks the agent installs. Task Scheduler runs them; nothing here starts or stops one."
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="WrapWholeWords"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Services}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="core:ScheduledTaskStatus">
                                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          AutomationProperties.Name="{x:Bind AccessibleName}">
                                    <Expander.Header>
                                        <!-- No selectable text here, so a click anywhere reaches the header's toggle -->
                                        <Grid ColumnSpacing="12" Padding="0,8,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontFamily="Cascadia Mono, Consolas"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                                         Fill="{x:Bind Tone, Converter={StaticResource StatusToneToBrush}}" />
                                                <TextBlock Text="{x:Bind State}" VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="8">
                                        <ItemsControl ItemsSource="{x:Bind Details}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="core:StatusDetail">
                                                    <Grid ColumnSpacing="12" Padding="0,2,0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   FontFamily="{x:Bind Monospace, Converter={StaticResource Monospace}}"
                                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Bind Note}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True"
                                                   Visibility="{x:Bind HasNote, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
