#!/bin/zsh
# Managed Presence Beacon postinstall: data folder, the managedpresencebeacon links,
# then (re)load the agent and the prefs helper.
#
# PULSE_TEST_ROOT runs this against a scratch directory: every path is prefixed with
# it and launchd is left alone. The installer never sets it.

ROOT="${PULSE_TEST_ROOT:-}"
APP="${ROOT}/Applications/Utilities/Managed Presence Beacon.app"
CLI="${APP}/Contents/MacOS/managedpresencebeacon"
DATA="${ROOT}/Library/Managed Presence"
AGENT_PLIST="${ROOT}/Library/LaunchDaemons/com.github.computerpulse.plist"
HELPER_SRC="${APP}/Contents/Library/LaunchDaemons/com.github.computerpulse.helper.plist"
HELPER_PLIST="${ROOT}/Library/LaunchDaemons/com.github.computerpulse.helper.plist"

log() { echo "managedpresencebeacon postinstall: $1"; }
launchctl_run() {
    if [[ -n "${ROOT}" ]]; then log "(test root) skipped: launchctl $*"; return 0; fi
    /bin/launchctl "$@"
}


# bootout returns before a terminating job necessarily disappears. Wait for removal
# before bootstrapping, then tolerate transient launchd registration failures.
reload_job() {
    local label="$1" plist="$2" attempt
    if [[ -n "${ROOT}" ]]; then
        log "(test root) skipped: reload ${label}"
        return 0
    fi
    launchctl_run bootout "system/${label}" 2>/dev/null || true
    for attempt in {1..15}; do
        if ! launchctl_run print "system/${label}" >/dev/null 2>&1; then
            break
        fi
        /bin/sleep 1
    done
    if launchctl_run print "system/${label}" >/dev/null 2>&1; then
        log "ERROR: ${label} did not finish unloading"
        return 1
    fi
    for attempt in {1..15}; do
        if launchctl_run bootstrap system "${plist}"; then
            if launchctl_run print "system/${label}" >/dev/null 2>&1; then
                log "loaded ${label}"
                return 0
            fi
        fi
        /bin/sleep 1
    done
    log "ERROR: ${label} was not loaded after bounded retries"
    return 1
}

# The agent runs as root and writes here; nobody else may.
mkdir -p "${DATA}/logs"
chown -R root:wheel "${DATA}" 2>/dev/null || [[ -n "${ROOT}" ]]
chmod 755 "${DATA}" "${DATA}/logs"

if [[ ! -x "${CLI}" ]]; then
    log "ERROR: ${CLI} is missing"
    exit 1
fi
# The CLI lives in the app bundle; like the other management tools it is linked from
# /usr/local/<tool> and onto PATH from /usr/local/bin.
mkdir -p "${ROOT}/usr/local/computerpulse" "${ROOT}/usr/local/bin"
ln -sf "${CLI#${ROOT}}" "${ROOT}/usr/local/computerpulse/managedpresencebeacon"
ln -sf "${CLI#${ROOT}}" "${ROOT}/usr/local/bin/managedpresencebeacon"

chmod 644 "${AGENT_PLIST}"
chown root:wheel "${AGENT_PLIST}" 2>/dev/null || [[ -n "${ROOT}" ]]
# launchctl load is a no-op for a label already loaded, so boot out first; the
# agent's SIGTERM handler reports the seat off and the new one reports it back.
reload_job com.github.computerpulse "${AGENT_PLIST}" || exit 1

# The helper's plist ships inside the app for SMAppService; launchd needs a plain
# copy with ProgramArguments.
if [[ -f "${HELPER_SRC}" ]]; then
    cp "${HELPER_SRC}" "${HELPER_PLIST}"
    /usr/libexec/PlistBuddy -c "Delete :BundleProgram" "${HELPER_PLIST}" 2>/dev/null || true
    /usr/libexec/PlistBuddy -c "Add :ProgramArguments array" "${HELPER_PLIST}"
    /usr/libexec/PlistBuddy -c "Add :ProgramArguments:0 string ${APP#${ROOT}}/Contents/MacOS/ManagedPresenceBeaconHelper" "${HELPER_PLIST}"
    chmod 644 "${HELPER_PLIST}"
    chown root:wheel "${HELPER_PLIST}" 2>/dev/null || [[ -n "${ROOT}" ]]
    reload_job com.github.computerpulse.helper "${HELPER_PLIST}" || exit 1
fi

log "installed $("${CLI}" --version 2>/dev/null)"
exit 0
